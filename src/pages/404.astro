---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | Bab al-Ridha Institute"
  description="The requested page could not be found."
  robots="noindex"
>
  <main class="min-h-screen flex items-center justify-center px-6 text-center">
    <div>
      <p class="text-gold font-semibold tracking-widest">404</p>
      <h1 class="mt-4 text-4xl font-bold text-deep-green">Page not found</h1>
      <p class="mt-4 text-gray-700">The page you requested does not exist.</p>
      <a class="mt-8 inline-block rounded bg-deep-green px-6 py-3 text-white" href="/">Return home</a>
    </div>
  </main>
</Layout>
